<div id="app">
  <div class="wx">
    <% if weather %>
      <div class="temp"><%= weather.temp %></div>
      <div><div class="cond"><%= weather.condition %></div><div class="feel"><%= weather.feel %></div></div>
      <div class="hours">
        <% weather.hours.each do |h| %>
          <div class="hour <%= h.icon %>"><div class="h"><%= h.time %></div><%= icon(h.icon) %><div class="t"><%= h.temp %></div></div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if weather&.alerts&.any? %>
    <div class="alerts<%= " crowded" if weather.alerts.size > 2 %>">
      <% weather.alerts.each do |a| %>
        <div class="alert <%= a.kind %>"><%= icon(a.kind) %><div class="txt"><div class="t"><%= a.title %></div><div class="s"><%= a.sub %></div></div></div>
      <% end %>
    </div>
  <% end %>

  <% if all_day.any? %>
    <div class="allday">
      <div class="lbl">HELE DAGEN</div>
      <% all_day.each do |e| %>
        <div class="chip<%= " tentative" if tentative?(e) %>"><% e[:who].each do |p| %><%= avatar(p) %><% end %><b><%= e[:title] %></b></div>
      <% end %>
    </div>
  <% end %>

  <div class="agenda" style="height:<%= rem(agenda.height) %>">
    <% agenda.items.each do |e| %>
      <% if e.day? %>
        <div class="day"><%= e.label %></div>
      <% else %>
        <div class="ev<%= " now" if e.now %><%= " tentative" if e.tentative %>">
          <div class="when"><% if e.time %><div class="t1"><%= e.time %></div><% end %><div class="t2"><%= e.until %></div></div>
          <div class="txt"><div class="t"><%= e.title %></div><% if e.sub %><div class="s"><%= e.sub %></div><% end %></div>
          <div class="avs"><% e.who.each do |p| %><%= avatar(p) %><% end %></div>
        </div>
      <% end %>
    <% end %>
    <% if agenda.more.positive? %><div class="more">+ <%= agenda.more %> flere</div><% end %>
    <% if agenda.items.empty? && agenda.more.zero? %><div class="empty">Ingen aftaler</div><% end %>
  </div>

  <div class="el">
    <div class="elh"><div class="lbl">STRØMPRIS</div><% if prices.current %><div class="now"><b><%= prices.current %></b> kr/kWh nu</div><% end %></div>
    <div class="chart">
      <% prices.lines.each do |l| %>
        <div class="line<%= " good" if l[:good] %>" style="bottom:<%= (l[:bottom] * 100).round(2) %>%"><span><%= l[:value] %></span></div>
      <% end %>
      <% prices.bars.each do |b| %>
        <% if b %>
          <div class="slot"><div class="bar<%= " cheap" if b.cheap %><%= " now" if b.now %><%= " clipped" if b.clipped %>" style="height:<%= (b.height * 100).round(2) %>%"></div></div>
        <% else %>
          <div class="slot"></div>
        <% end %>
      <% end %>
    </div>
    <div class="ticks"><% prices.labels.each do |l| %><div><%= l %></div><% end %></div>
  </div>

  <div class="stale"><%= "forældet: #{stale.join(", ")}" if stale.any? %></div>
</div>
